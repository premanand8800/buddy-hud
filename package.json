{
  "name": "buddy-hud",
  "version": "0.5.0",
  "description": "A floating pixel buddy that shows what Claude Code is doing - live diffs, permissions, context, replies. Unofficial.",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "hooks": "node install-hooks.js",
    "hooks:remove": "node install-hooks.js --uninstall",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "promo": "electron promo/record.js portrait promo/out.mp4",
    "test": "node test/install-hooks.test.js && node test/usage.test.js && node test/e2e.js",
    "test:unit": "node test/install-hooks.test.js",
    "test:e2e": "node test/e2e.js",
    "build:3d": "esbuild renderer/src/buddy3d.js --bundle --minify --format=iife --target=chrome120 --outfile=renderer/buddy3d.bundle.js"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "three": "^0.186.1"
  },
  "productName": "Buddy HUD",
  "author": {
    "name": "premanand8800",
    "email": "premanand8800@users.noreply.github.com"
  },
  "keywords": [
    "claude-code",
    "claude",
    "hud",
    "overlay",
    "electron",
    "desktop-companion",
    "hooks"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/premanand8800/buddy-hud.git"
  },
  "build": {
    "appId": "dev.buddyhud.app",
    "productName": "Buddy HUD",
    "artifactName": "buddy-hud-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "preload-diff.js",
      "install-hooks.js",
      "lib/**",
      "renderer/**",
      "build/icon.png",
      "build/tray.png",
      "build/tray@2x.png",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "executableArgs": [
        "--no-sandbox"
      ],
      "maintainer": "premanand8800 <premanand8800@users.noreply.github.com>"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "buddy-hud-${version}-win-setup.${ext}"
    },
    "portable": {
      "artifactName": "buddy-hud-${version}-win-portable.${ext}"
    }
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
